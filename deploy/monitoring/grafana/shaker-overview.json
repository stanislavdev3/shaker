    {"type":"timeseries","title":"Errors and retries","gridPos":{"h":8,"w":12,"x":12,"y":4},"datasource":{"type":"prometheus","uid":"Prometheus"},"targets":[{"expr":"sum by (provider) (rate(shaker_provider_polls_total{result=\"error\"}[$__rate_interval]))","legendFormat":"provider {{provider}}","refId":"A"},{"expr":"sum(rate(shaker_core_observations_total{result=\"error\"}[$__rate_interval]))","legendFormat":"core","refId":"B"},{"expr":"sum(rate(shaker_core_outbox_publishes_total{result=~\".*error\"}[$__rate_interval]))","legendFormat":"outbox","refId":"C"},{"expr":"sum by (channel) (rate(shaker_notification_deliveries_total{result!=\"sent\"}[$__rate_interval]))","legendFormat":"notification {{channel}}","refId":"D"}],"fieldConfig":{"defaults":{"unit":"ops"},"overrides":[]}},
    {"type":"timeseries","title":"API latency and server errors","gridPos":{"h":8,"w":12,"x":0,"y":12},"datasource":{"type":"prometheus","uid":"Prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{component=\"api\"}[$__rate_interval])))","legendFormat":"p95 latency","refId":"A"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
