APP_ENV=development
APP_VERSION=dev
APP_ROLE=all
HTTP_ADDRESS=:8080
WORKER_METRICS_ADDRESS=:9090
DATABASE_URL=postgres://earthquake:earthquake@postgres:5432/earthquake?sslmode=disable
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
USGS_REALTIME_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
USGS_FDSN_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
USGS_POLL_INTERVAL=60s
USGS_HTTP_TIMEOUT=20s
USGS_MAX_RESPONSE_BYTES=26214400
EMSC_ENABLED=false
EMSC_WEBSOCKET_URL=wss://www.seismicportal.eu/standing_order/websocket
EMSC_FDSN_URL=https://www.seismicportal.eu/fdsnws/event/1/query
EMSC_POLL_INTERVAL=30s
EMSC_HTTP_TIMEOUT=20s
EMSC_LOOKBACK_DURATION=2h
EMSC_PING_INTERVAL=15s
EMSC_MAX_RESPONSE_BYTES=26214400
EMSC_MAX_FRAME_BYTES=262144
BACKFILL_CHUNK_DURATION=24h
RECOVERY_OVERLAP_DURATION=1h
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_MAX_ATTEMPTS=10
NOTIFICATION_LOCK_TIMEOUT=5m
NOTIFICATION_POLL_INTERVAL=1s
ADMIN_API_KEY=replace-with-a-long-random-value
ADMIN_ENABLED=false
ADMIN_HOST=eq.screaming.dog
CLOUDFLARE_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=
ADMIN_BOOTSTRAP_OWNERS=admin@example.com
# Development-only Cloudflare Access bypass. Never set this outside APP_ENV=development.
ADMIN_DEVELOPMENT_EMAIL=
GRAFANA_BASE_URL=
# Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
WEBHOOK_ALLOW_PRIVATE_NETWORKS=true
WEBHOOK_HTTP_TIMEOUT=15s
WEBHOOK_MAX_RESPONSE_BYTES=65536
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_GLOBAL_CHANNEL=
TELEGRAM_POLL_TIMEOUT=25s
TELEGRAM_MAX_RESPONSE_BYTES=1048576
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
